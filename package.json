{
  "name": "ask-a-muslim",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:AskAMuslim": "node dist/AskAMuslim/server/server.mjs",
    "build:tokens": "style-dictionary build",
    "generate:api": "ng-openapi-gen -c ng-openapi-gen.json",
    "swagger:hash": "node scripts/swagger-hash.mjs",
    "swagger:check": "node scripts/swagger-hash.mjs --check",
    "swagger:update": "node scripts/swagger-hash.mjs --update",
    "api:sync": "npm run swagger:check || (npm run generate:api && npm run swagger:update)",
    "lint": "eslint ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.5.1",
    "@angular/animations": "20.3.16",
    "@angular/common": "20.3.16",
    "@angular/compiler": "20.3.16",
    "@angular/core": "20.3.16",
    "@angular/forms": "20.3.16",
    "@angular/platform-browser": "20.3.16",
    "@angular/platform-server": "20.3.16",
    "@angular/router": "20.3.16",
    "@angular/ssr": "20.3.16",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@tailwindcss/postcss": "^4.1.17",
    "esbuild": "^0.27.3",
    "express": "^5.1.0",
    "fast-uri": "^3.1.0",
    "flowbite": "^3.1.2",
    "gsap": "^3.13.0",
    "jspdf": "^2.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.16",
    "@angular-devkit/core": "^20.3.16",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/build": "^20.3.16",
    "@angular/cli": "^20.3.16",
    "@angular/compiler-cli": "^20.3.16",
    "@angular/platform-browser-dynamic": "20.3.16",
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "ajv": "^8.18.0",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.11",
    "chrome-devtools-mcp": "^0.17.0",
    "eslint": "^9.39.2",
    "fast-deep-equal": "^3.1.3",
    "jasmine-core": "~5.9.0",
    "json-schema-traverse": "^1.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "log-update": "^7.1.0",
    "ng-openapi-gen": "^1.0.5",
    "postcss": "^8.5.6",
    "require-from-string": "^2.0.2",
    "style-dictionary": "^5.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.55.0",
    "uri-js": "^4.4.1"
  }
}
