{
  "name": "ask-a-muslim",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --watch",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:AskAMuslim": "node dist/AskAMuslim/server/server.mjs",
    "build:tokens": "style-dictionary build",
    "generate:api": "ng-openapi-gen -c ng-openapi-gen.json",
    "swagger:hash": "node scripts/swagger-hash.mjs",
    "swagger:check": "node scripts/swagger-hash.mjs --check",
    "swagger:update": "node scripts/swagger-hash.mjs --update",
    "api:sync": "npm run swagger:check || (npm run generate:api && npm run swagger:update)",
    "speckit": "node speckit.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@abacritt/angularx-social-login": "2.5.1",
    "@angular/animations": "20.3.17",
    "@angular/common": "20.3.17",
    "@angular/compiler": "20.3.17",
    "@angular/core": "20.3.17",
    "@angular/forms": "20.3.17",
    "@angular/platform-browser": "20.3.17",
    "@angular/platform-browser-dynamic": "20.3.17",
    "@angular/platform-server": "20.3.17",
    "@angular/router": "20.3.17",
    "@angular/ssr": "20.3.17",
    "@fortawesome/fontawesome-free": "7.1.0",
    "@tiptap/core": "^3.20.1",
    "@tiptap/extension-color": "^3.20.1",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-text-style": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "aos": "2.3.4",
    "dompurify": "^3.3.2",
    "express": "5.1.0",
    "flowbite": "3.1.2",
    "gsap": "3.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.0",
    "rxjs": "7.8.1",
    "tslib": "2.6.2",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.17",
    "@angular-eslint/eslint-plugin": "20.0.0",
    "@angular-eslint/eslint-plugin-template": "20.0.0",
    "@angular-eslint/schematics": "20.0.0",
    "@angular-eslint/template-parser": "20.0.0",
    "@angular/cli": "20.3.17",
    "@angular/compiler-cli": "20.3.17",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/aos": "3.0.7",
    "@types/express": "5.0.1",
    "@types/jasmine": "5.1.0",
    "@types/node": "25.3.5",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.2",
    "jasmine-core": "5.9.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "ng-openapi-gen": "1.0.5",
    "postcss": "8.5.6",
    "style-dictionary": "4.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1"
  }
