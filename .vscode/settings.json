{
  "builder.serverUrl": "",
  "builder.command": "npm run start",
  "builder.runDevServer": false,
  "builder.autoDetectDevServer": true,
  "builder.launchType": "editor",
  "chat.tools.terminal.autoReplyToPrompts": true,
  "chat.mcp.serverSampling": {
    "AskAMuslim/.vscode/mcp.json: TalkToFigma": {
      "allowedModels": [
        "copilot/auto",
        "copilot/claude-opus-4.5",
        "copilot/claude-opus-4.6",
        "copilot/claude-sonnet-4.5",
        "copilot/gemini-3-pro-preview",
        "copilot/gpt-5.1-codex-max",
        "copilot/gpt-5.2-codex"
      ]
    }
  },
  "chat.promptFilesRecommendations": {},
  "chat.tools.terminal.autoApprove": {
    ".specify/scripts/bash/": true,
    ".specify/scripts/powershell/": true
  },
  "editor.defaultFormatter": "sdteotonio.angular-formatter",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "aeschli.vscode-css-formatter"
  },
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  }
}