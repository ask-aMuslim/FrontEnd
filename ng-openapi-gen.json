{
  "$schema": "node_modules/ng-openapi-gen/ng-openapi-gen-schema.json",
  "input": "https://api.askamuslim.com/api/specification.json",
  "output": "src/app/api",
  "ignoreUnusedModels": false,
  "modelIndex": true,
  "serviceIndex": true,
  "enumWithValues": true,
  "dateFormat": "string",
  "module": "ApiModule",
  "prefix": "",
  "camelCase": true,
  "skipJsonSuffix": true
}
