{
    "source": [
        "tokens.json"
    ],
    "platforms": {
        "css": {
            "transformGroup": "css",
            "buildPath": "src/styles/tokens/",
            "files": [
                {
                    "destination": "variables.css",
                    "format": "css/variables"
                }
            ]
        },
        "js": {
            "transformGroup": "js",
            "buildPath": "src/styles/tokens/",
            "files": [
                {
                    "destination": "tokens.js",
                    "format": "javascript/module"
                }
            ]
        }
    }
}